<apex:page standardController="Opportunity" extensions="VisualController" renderAs="pdf" applyBodyTag="false">
    <head>
       // 2. Styles layer
       <style>
            /* A4 print sheet settings */
            @page {
                size: A4; /* Paper format */
                margin: 0; /* Remove margins so the orange bar at the top touches the edges */
                
                /* Special area at the bottom of the page for the footer */
                @bottom-center {
                    /* content: prints text at the bottom of every PDF page */
                    content: "Company: {!companyInfo.Name}"; 
                    font-size: 10pt;
                    color: #808080; /* Grey text color */
                }
            }
            
            /* Base font and reset of spacing for the whole document */
            body { font-family: sans-serif; margin: 0; padding: 0; }

            /* Orange decorative bar at the very top (as in the task mockup) */
            .header-bar { background-color: #FF5722; height: 20px; width: 100%; }

            /* Content container with inner padding from the page edges */
            .content { padding: 40px; }

            /* LOGO block: grey circle with white text in the middle */
            .logo-circle { 
                background: #777; 
                color: white; 
                width: 60px; 
                height: 60px; 
                border-radius: 50%; /* Makes the square round */
                text-align: center; 
                line-height: 60px; /* Centers the text vertically */
                font-size: 10pt;
            }

            /* INVOICE title: large, grey, aligned to the right edge */
            .invoice-title { text-align: right; color: #777; font-size: 24pt; margin: 0; }
            
            /* Table styles: full width and no double borders */
            table { width: 100%; border-collapse: collapse; margin-top: 30px; }
            
            /* Table header: orange background, bold white text */
            th { background-color: #FF5722; color: white; padding: 10px; text-align: left; }
            
            /* Table cells: padding and a thin bottom line to separate products */
            td { padding: 10px; border-bottom: 1px solid #eee; }
            
            /* Pink block for the total amount (Balance Due) */
            .balance-box { 
                float: right; /* Moves the whole block to the right */
                margin-top: 20px; 
                background-color: #F8D7DA; /* Light pink background */
                padding: 10px 20px; 
                font-weight: bold; 
                font-size: 16pt;
            }
        </style >
    </head>
 // 3. The "foundation" of the invoice header.
    <div class="header-bar"></div>
    
    <div class="content">
        <table style="border:none;">
            <tr>
                <td style="border:none; width: 50%;">
                    <div class="logo-circle">LOGO</div>
                    <p>
                        <strong>{!companyInfo.Name}</strong><br/>
                        {!companyInfo.Street}, {!companyInfo.City}
                    </p>
                </td>
                //4. Right part of the header
                <td style="border:none; text-align:right; vertical-align:top;">
                    <h1 class="invoice-title">INVOICE</h1>
                    <p>DATE:<apex:outputText value="{0, date, MMMM d, yyyy}">
        <apex:param value="{!generationDate}" />
    </apex:outputText>
</p>
        // 5. Invoice number
        <p><strong>INVOICE NO. {!opp.Invoice_Number__c}</strong></p>
                </td>
            </tr>
        </table>

        //6.«BILL TO»
        <div style="margin-top:40px;">
            <h4 style="color: #303F9F; border-bottom: 1px solid #303F9F; padding-bottom: 5px;">BILL TO</h4>
            <p>
                {!primaryContact.Contact.Name}<br/>
                {!primaryContact.Opportunity.Account.Name}<br/>
                {!primaryContact.Contact.Phone}<br/>
                {!primaryContact.Contact.Email}
            </p>
        </div>
     
        // 7. Product list table
        <table>
            <thead>
                <tr>
                    <th>PRODUCT NAME</th>
                    <th>QUANTITY</th>
                    <th>UNIT PRICE</th>
                    <th>TOTAL</th>
                </tr>
            </thead>
            <tbody>
                //8. Visualforce turns the list of data from Apex into neat invoice rows
                <apex:repeat value="{!lineItems}" var="item">
                    <tr>
                        <td>{!item.PricebookEntry.Product2.Name}</td>
                        <td>{!item.Quantity}</td>
                        <td>${!item.UnitPrice}</td>
                        <td>${!item.TotalPrice}</td>
                    </tr>
                </apex:repeat>
            </tbody>
        </table>

        <div class="balance-box">
            Balance Due &nbsp;&nbsp; ${!opp.Amount}
        </div>
    </div>
</apex:page>
